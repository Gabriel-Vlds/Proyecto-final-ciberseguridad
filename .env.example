# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repositorio.
SECRET_KEY=replace-with-a-random-local-secret
DEMO_USERNAME=choose-a-local-username
DEMO_PASSWORD=choose-a-unique-local-password
# Contrasena de las cuentas de paciente de laboratorio (usuarios: mariana y carlos)
PATIENT_PASSWORD=choose-a-unique-local-password-for-patients

# Interruptores de laboratorio: 1 = version VULNERABLE (solo para demostrar), 0 = version corregida
VULN_SQLI=0
VULN_XSS=0
VULN_IDOR=0
